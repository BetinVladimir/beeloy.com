# Copy to .env (never commit it). Used by docker compose (infra/compose) and the Go services.
APP_ENV=prod
HTTP_ADDR=:8080
METRICS_ADDR=:9090
PUBLIC_BASE_URL=https://beeloy.com
ALLOWED_ORIGINS=https://beeloy.com

POSTGRES_USER=beeloy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beeloy
DATABASE_URL=postgres://beeloy:change-me@postgres:5432/beeloy?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://redis:6379/0

# >= 32 characters, random
OTP_HMAC_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@beeloy.com
TERMS_VERSION=2026-11-04
PRIVACY_VERSION=2026-11-04
LOG_LEVEL=info

# Cloudflare IP ranges (infra/scripts/update-cf-ips.sh) and the secret shared with the Next.js Worker
# Caddy's fixed address on the private `proxy` network (never the Cloudflare ranges)
TRUSTED_PROXY_CIDRS=172.30.0.2/32
# Cloudflare ranges, space separated: the only peers Caddy accepts (see infra/scripts/update-cf-ips.sh)
CLOUDFLARE_CIDRS=
PROXY_SHARED_SECRET=

# S3-compatible content storage. api: read/write; content-sync: read only; translator: read/write (separate keys)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=

# Deletion journal (api, prod): a SEPARATE bucket with its own credentials, e.g. the backup bucket.
# DELETION_JOURNAL_KEY is 64 hex chars (openssl rand -hex 32); keep a copy outside the server.
JOURNAL_S3_ENDPOINT=
JOURNAL_S3_REGION=
JOURNAL_S3_BUCKET=
JOURNAL_S3_ACCESS_KEY=
JOURNAL_S3_SECRET_KEY=
JOURNAL_S3_PREFIX=
DELETION_JOURNAL_KEY=
SYNC_INTERVAL_UI=5m
SYNC_INTERVAL_ARTICLES=1m

# translator CLI (run by an operator, not by compose)
OLLAMA_URL=
OLLAMA_MODEL=
TRANSLATOR_REQUEST_TIMEOUT=10m

# backups (restic) — a separate bucket
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Social sign-in (api only). Register https://beeloy.com/api/v1/auth/oauth/{google,facebook}/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
