# Local development (copy to .env.local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Social sign-in buttons; empty = disabled (e-mail code only). Set "google,facebook" once the API has *_CLIENT_ID/SECRET.
NEXT_PUBLIC_SOCIAL_PROVIDERS=
API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=bg
# Shared with the API; set as a Worker secret in production (wrangler secret put PROXY_SHARED_SECRET)
PROXY_SHARED_SECRET=dev-proxy-secret-dev-proxy-secret-00
